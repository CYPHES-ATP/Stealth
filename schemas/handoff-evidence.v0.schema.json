{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stealth.cyphes.com/schemas/handoff-evidence.v0.schema.json",
  "title": "Stealth Handoff Evidence v0",
  "description": "Stable evidence JSON format for Stealth session handoff verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "session_id",
    "directory",
    "task",
    "agent",
    "scope",
    "commands",
    "changes",
    "metadata"
  ],
  "properties": {
    "schema": {
      "const": "stealth.session.evidence.v0"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "directory": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime"],
      "properties": {
        "id": {
          "type": "string"
        },
        "runtime": {
          "const": "Stealth"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "permission": {}
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command"],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": "number"
          },
          "stdout_summary": {
            "type": "string"
          }
        }
      }
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files_changed", "diff_sha256"],
      "properties": {
        "files_changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diff_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_count", "diff_count", "generated_by"],
      "properties": {
        "message_count": {
          "type": "number",
          "minimum": 0
        },
        "diff_count": {
          "type": "number",
          "minimum": 0
        },
        "generated_by": {
          "const": "stealth.handoff.evidence.builder.v0"
        }
      }
    }
  }
}
